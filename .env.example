# Qloo hackathon key (server-side only — never prefix with NEXT_PUBLIC_)
QLOO_API_KEY=
# Hackathon keys only work against this base URL
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: Google Gemini key for the narration step (free tier is enough).
# If empty, the agent writes its own deterministic narration — every feature still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: per-IP plan requests allowed per 10 minutes (default 12)
RATE_LIMIT_PER_10MIN=12
